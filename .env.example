# ===================================================
# API Gateway — Kong — Variables de entorno
# ===================================================
#
# Se leen a través del vault de entorno de Kong, que se referencia en kong.yml
# como {vault://env/space-auth-internal-secret}: el nombre del recurso pasa a
# mayúsculas y los guiones a subrayados, SIN prefijo. No se usa el prefijo
# KONG_ porque ese espacio de nombres es el de la configuración de Kong.
#
# IMPORTANTE: Kong fotografía el entorno al inicializar el worker. Un cambio
# aquí NO se aplica con `kong reload`; hay que recrear el contenedor:
#   docker compose -f docker-compose.dev.yml up -d --force-recreate kong

# Secreto compartido con auth para POST /v1/auth/validate-key (cabecera
# X-Internal-Secret). Debe coincidir con INTERNAL_API_SECRET de auth-microservice.
SPACE_AUTH_INTERNAL_SECRET=dev_internal_secret_key_789

# Clave de firma de los JWT que emite auth. La pasarela solo verifica; no firma.
# Debe coincidir con JWT_SECRET de auth-microservice.
SPACE_AUTH_JWT_SECRET=dev_jwt_secret_change_me
